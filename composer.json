{
  "name": "tuxxedo/engine",
  "description": "Tuxxedo Engine",
  "minimum-stability": "stable",
  "license": "MIT",
  "version": "0.1.0",
  "type": "library",
  "authors": [
    {
      "name": "Kalle Sommer Nielsen",
      "email": "kalle@php.net"
    }
  ],
  "require": {
    "php": ">=8.5",
    "ext-filter": "*",
    "ext-intl": "*",
    "ext-json": "*",
    "ext-mbstring": "*"
  },
  "require-dev": {
    "phpstan/phpstan": "2.*",
    "phpunit/phpunit": "13.*",
    "phpstan/phpstan-strict-rules": "2.*",
    "phpstan/extension-installer": "1.*",
    "friendsofphp/php-cs-fixer": "3.*",
    "brianium/paratest": "7.*"
  },
  "replace": {
    "symfony/polyfill-intl-grapheme": "*",
    "symfony/polyfill-intl-normalizer": "*",
    "symfony/polyfill-mbstring": "*",
    "symfony/polyfill-php80": "*",
    "symfony/polyfill-php81": "*",
    "symfony/polyfill-php84": "*",
    "symfony/polyfill-php85": "*"
  },
  "scripts": {
    "test": "vendor/bin/phpunit",
    "test:parallel": "vendor/bin/paratest --processes=auto"
  },
  "suggest": {
    "ext-fileinfo": "For better file type detection in uploaded files",
    "ext-mysqli": "For database connections to mysql",
    "ext-openssl": "For crypto support in JWT, and Email signing",
    "ext-pdo": "For database connections using PDO",
    "ext-pdo-mysql": "For database connections to mysql using PDO",
    "ext-pdo-pgsql": "For database connections to postgres using PDO",
    "ext-pdo-sqlite": "For database connections to sqlite using PDO",
    "ext-pgsql": "For database connections to postgres",
    "ext-session": "For session support",
    "ext-sodium": "For crypto support in JWT, and Email signing",
    "ext-sqlite3": "For database connections to sqlite",
    "ext-zlib": "For DEFLATE payload compression in JWE"
  },
  "autoload": {
    "psr-4": {
      "App\\": "app/",
      "Console\\": "console/",
      "Tuxxedo\\": "src/Tuxxedo/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Fixture\\": "tests/Fixture/",
      "Integration\\": "tests/Integration/",
      "Support\\": "tests/Support/",
      "Unit\\": "tests/Unit/"
    }
  },
  "config": {
    "allow-plugins": {
      "phpstan/extension-installer": true
    }
  }
}
