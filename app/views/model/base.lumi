{% layout 'layout/base' %}

{% block extra_head %}
    {% for language in locale_all() %}
        {% set tag = language.tag | lower %}
        <link rel="alternate" hreflang="{! language.tag | escape_attr !}" href="{! url(route(['language': tag])) | escape_attr !}">
    {% endfor %}
    <link rel="alternate" hreflang="x-default" href="{! url(route(['language': null])) | escape_attr !}">
{% endblock %}

{% block extra_css %}
    a {
        color: var(--path);
        text-decoration: none;
        transition: color .15s ease;
    }

    a:hover {
        color: #d5e7f2;
        text-decoration: underline;
    }

    header .toolbar {
        display: flex;
        gap: 8px;
    }

    .dropdown {
        position: relative;
    }

    .dropdown > summary {
        list-style: none;
        cursor: pointer;
    }

    .dropdown > summary::-webkit-details-marker {
        display: none;
    }

    .dropdown > summary::after {
        content: "\25BE";
        margin-left: 8px;
        font-size: 10px;
    }

    .dropdown .menu {
        position: absolute;
        right: 0;
        top: calc(100% + 6px);
        z-index: 10;
        display: flex;
        flex-direction: column;
        gap: 6px;
        min-width: 100%;
        padding: 6px;
        background: var(--panel);
        border: 1px solid var(--line);
        border-radius: 6px;
        backdrop-filter: blur(8px);
    }

    .dropdown .menu .btn {
        white-space: nowrap;
    }

    .dropdown .menu .btn.active {
        color: var(--fg);
        background: rgba(163, 200, 222, 0.14);
        border-color: rgba(163, 200, 222, 0.40);
        cursor: default;
    }

    .btn {
        display: inline-flex;
        align-items: center;
        padding: 7px 14px;
        background: rgba(255, 255, 255, 0.04);
        color: var(--path);
        font: 500 12px/1 var(--mono);
        letter-spacing: 0.02em;
        text-decoration: none;
        border: 1px solid rgba(255, 255, 255, 0.08);
        border-radius: 6px;
        transition: background .15s ease, border-color .15s ease, color .15s ease;
    }

    .btn:hover {
        background: rgba(163, 200, 222, 0.10);
        border-color: rgba(163, 200, 222, 0.32);
        color: #d5e7f2;
        text-decoration: none;
    }

    table {
        width: 100%;
        border-collapse: collapse;
        margin: 8px 0 0 0;
        border-top: 1px solid var(--line);
    }

    table thead th {
        text-align: left;
        font: 500 12px/1.4 var(--mono);
        color: var(--dim);
        text-transform: uppercase;
        letter-spacing: 0.06em;
        padding: 10px 12px;
        border-bottom: 1px solid var(--line);
        font-weight: 500;
    }

    table thead th strong {
        font-weight: 500;
    }

    table tbody td {
        padding: 10px 12px;
        border-bottom: 1px solid var(--line);
        font: 13px/1.4 var(--mono);
        vertical-align: middle;
    }

    table tbody td strong {
        color: var(--dim);
        font: 500 11px/1.2 var(--mono);
        text-transform: uppercase;
        letter-spacing: 0.06em;
    }

    table tbody tr:hover {
        background: var(--hover);
    }

    table td.actions {
        text-align: right;
        white-space: nowrap;
        width: 1%;
    }

    table td.actions a {
        margin-left: 14px;
    }

    table td.actions a:first-child {
        margin-left: 0;
    }

    pre.code {
        margin: 8px 0 0 0;
        padding: 16px 18px;
        background: rgba(0, 0, 0, 0.34);
        border: 1px solid var(--line);
        border-radius: 6px;
        font: 13px/1.55 var(--mono);
        color: var(--fg);
        overflow-x: auto;
        white-space: pre;
        tab-size: 4;
        -moz-tab-size: 4;
    }

{% include 'support/form_css' %}

    nav.pagination {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 16px;
        margin-top: 20px;
        padding: 14px 4px 0;
        border-top: 1px solid var(--line);
        font: 12px/1.4 var(--mono);
        color: var(--dim);
    }

    nav.pagination .links {
        display: flex;
        gap: 8px;
    }

    nav.pagination .status {
        color: var(--dim);
    }
{% endblock %}

{% block main %}
    <main>
        <header>
            <h1>{{ t('model.title') }}</h1>
            <div class="toolbar">
                {% yield buttons %}
                <details class="dropdown">
                    <summary class="btn" lang="{! locale().tag | escape_attr !}">{{ locale().displayName }}</summary>
                    <div class="menu">
                        {% for language in locale_all() %}
                            {% if language.tag === locale().tag %}
                                <span class="btn active" lang="{! language.tag | escape_attr !}" aria-current="true">{{ language.displayName }}</span>
                            {% else %}
                                {% set tag = language.tag | lower %}
                                <a href="{! route(['language': tag]) | escape_attr !}" class="btn" lang="{! language.tag | escape_attr !}">{{ language.displayName }}</a>
                            {% endif %}
                        {% endfor %}
                    </div>
                </details>
            </div>
        </header>
        {% yield content %}
        <footer>
            <small>{{ t('model.renderedAt', ['date': date_now('c') | locale_date_full]) }}</small>
        </footer>
    </main>
    <script>
        document.addEventListener(
            'click',
            function (event) {
                document.querySelectorAll('details.dropdown[open]').forEach(
                    function (dropdown) {
                        if (!dropdown.contains(event.target)) {
                            dropdown.removeAttribute('open');
                        }
                    }
                );
            }
        );

        document.addEventListener(
            'keydown',
            function (event) {
                if (event.key !== 'Escape') {
                    return;
                }

                document.querySelectorAll('details.dropdown[open]').forEach(
                    function (dropdown) {
                        dropdown.removeAttribute('open');
                    }
                );
            }
        );
    </script>
{% endblock %}
