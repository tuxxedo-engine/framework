{% layout 'model/base' %}

{% block buttons %}
    <a href="{! route('model.index') | escape_attr !}" class="btn">
        Back
    </a>
{% endblock %}

{% block content %}
    <form action="{! route() | escape_attr !}" method="post">
        <div class="field">
            <label for="name">Name</label>
            <input type="text" id="name" name="name">
        </div>
        <input type="submit" value="Create">
    </form>
{% endblock %}
