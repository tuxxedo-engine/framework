{% layout 'model/base' %}

{% block buttons %}
    <a href="{! route('model.index') | escape_attr !}" class="btn">
        {{ t('model.action.back') }}
    </a>
{% endblock %}

{% block content %}
    <form action="{! route() | escape_attr !}" method="post">
        {% if errors | count > 0 %}
            <div class="errors">
                <strong>{{ t('model.form.errors') }}</strong>
                <ul>
                    {% for error in errors %}
                        <li>{{ error }}</li>
                    {% endfor %}
                </ul>
            </div>
        {% endif %}
        <div class="field">
            <label for="name">{{ t('model.field.name') }}</label>
            <input type="text" id="name" name="name" value="{! name | escape_attr !}">
        </div>
        <input type="submit" value="{! t('model.action.create') | escape_attr !}">
    </form>
{% endblock %}
