{% layout 'model/base' %}

{% block buttons %}
    <a href="{! route('model.index') | escape_attr !}" class="btn">
        {{ t('model.action.back') }}
    </a>
{% endblock %}

{% block content %}
    <form action="{! route() | escape_attr !}" method="post">
        <p>{{ t('model.delete.confirm', ['id': user.id]) }}</p>
        <input type="submit" value="{! t('model.action.confirm') | escape_attr !}">
    </form>
{% endblock %}