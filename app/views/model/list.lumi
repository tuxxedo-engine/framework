{% layout 'model/base' %}

{% block buttons %}
    <a href="{! route('model.new') | escape_attr !}" class="btn">
        New
    </a>
    <a href="{! route('model.table') | escape_attr !}" class="btn">
        Table
    </a>
{% endblock %}

{% block content %}
    <table>
        <thead>
            <tr>
                <th>#</th>
                <th>Name</th>
                <th>&nbsp;</th>
            </tr>
        </thead>
        <tbody>
            {% for user in paginator %}
                <tr>
                    <td>{{ user.id }}</td>
                    <td>{{ user.name }}</td>
                    <td class="actions">
                        <a href="{! route('model.show', ['id': user.id]) | escape_attr !}">Show</a>
                        <a href="{! route('model.update', ['id': user.id]) | escape_attr !}">Edit</a>
                        <a href="{! route('model.delete', ['id': user.id]) | escape_attr !}">Delete</a>
                    </td>
                </tr>
            {% endfor %}
        </tbody>
    </table>

    <nav class="pagination">
        <div class="links">
            {% if paginator.hasPreviousPage %}
                <a href="{! route('model.list.page', ['page': paginator.previousPage]) | escape_attr !}" class="btn">
                    Previous
                </a>
            {% endif %}
            {% if paginator.hasNextPage %}
                <a href="{! route('model.list.page', ['page': paginator.nextPage]) | escape_attr !}" class="btn">
                    Next
                </a>
            {% endif %}
        </div>
        <span class="status">Page {{ paginator.page }} of {{ paginator.totalPages }} ({{ paginator.totalCount }} total)</span>
    </nav>
{% endblock %}
