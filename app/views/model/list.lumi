{% layout 'model/base' %}

{% block buttons %}
    <a href="{! route('model.new') | escape_attr !}" class="btn">
        {{ t('model.action.new') }}
    </a>
    <a href="{! route('model.table') | escape_attr !}" class="btn">
        {{ t('model.action.table') }}
    </a>
    <a href="{! route('model.metaData') | escape_attr !}" class="btn">
        {{ t('model.action.metaData') }}
    </a>
{% endblock %}

{% block content %}
    <table>
        <thead>
            <tr>
                <th>#</th>
                <th>{{ t('model.field.name') }}</th>
                <th>&nbsp;</th>
            </tr>
        </thead>
        <tbody>
            {% for user in paginator %}
                <tr>
                    <td>{{ user.id }}</td>
                    <td>{{ user.name }}</td>
                    <td class="actions">
                        <a href="{! route('model.show', ['id': user.id]) | escape_attr !}">{{ t('model.action.show') }}</a>
                        <a href="{! route('model.update', ['id': user.id]) | escape_attr !}">{{ t('model.action.edit') }}</a>
                        <a href="{! route('model.delete', ['id': user.id]) | escape_attr !}">{{ t('model.action.delete') }}</a>
                    </td>
                </tr>
            {% endfor %}
        </tbody>
    </table>

    <nav class="pagination">
        <div class="links">
            {% if paginator.hasPreviousPage %}
                <a href="{! route('model.list.page', ['page': paginator.previousPage]) | escape_attr !}" class="btn">
                    {{ t('model.action.previous') }}
                </a>
            {% endif %}
            {% if paginator.hasNextPage %}
                <a href="{! route('model.list.page', ['page': paginator.nextPage]) | escape_attr !}" class="btn">
                    {{ t('model.action.next') }}
                </a>
            {% endif %}
        </div>
        <span class="status">{{ t('model.list.page', ['page': paginator.page, 'pages': paginator.totalPages]) }} ({{ plural('model.list.total', paginator.totalCount, ['count': paginator.totalCount]) }})</span>
    </nav>
{% endblock %}
