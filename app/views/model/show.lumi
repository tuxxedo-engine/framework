{% layout 'model/base' %}

{% block buttons %}
    <a href="{! route('model.index') | escape_attr !}" class="btn">
        {{ t('model.action.back') }}
    </a>
{% endblock %}

{% block content %}
    <table>
        <tbody>
            <tr>
                <td><strong>{{ t('model.field.id') }}</strong></td>
                <td>{{ user.id }}</td>
            </tr>
            <tr>
                <td><strong>{{ t('model.field.name') }}</strong></td>
                <td>{{ user.name }}</td>
            </tr>
        </tbody>
    </table>
{% endblock %}
