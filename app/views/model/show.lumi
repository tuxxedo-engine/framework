{% layout 'model/base' %}

{% block buttons %}
    <a href="{! route('model.index') | escape_attr !}" class="btn">
        Back
    </a>
{% endblock %}

{% block content %}
    <table>
        <tbody>
            <tr>
                <td><strong>ID</strong></td>
                <td>{{ user.id }}</td>
            </tr>
            <tr>
                <td><strong>Name</strong></td>
                <td>{{ user.name }}</td>
            </tr>
        </tbody>
    </table>
{% endblock %}
