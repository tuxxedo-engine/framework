{% layout 'model/base' %}

{% block buttons %}
    <a href="{! route('model.index') | escape_attr !}" class="btn">
        {{ t('model.action.back') }}
    </a>
{% endblock %}

{% block content %}
    <table>
        <tbody>
            <tr>
                <td><strong>{{ t('model.meta.model') }}</strong></td>
                <td>{{ metaData.model }}</td>
            </tr>
            <tr>
                <td><strong>{{ t('model.meta.table') }}</strong></td>
                <td>{{ metaData.table }}</td>
            </tr>
            {% if metaData.key !== null && is_a(metaData.key, '\Tuxxedo\Model\MetaData\ModelPrimaryKey') %}
                <tr>
                    <td><strong>{{ t('model.meta.primaryKeyColumn') }}</strong></td>
                    <td>{{ t('model.meta.primaryKeyDeclaredOn', ['column': metaData.key.column, 'property': metaData.key.property]) }}</td>
                </tr>
                <tr>
                    <td><strong>{{ t('model.meta.primaryKeyAutoIncrement') }}</strong></td>
                    <td>{% if metaData.key.autoIncrement %}{{ t('model.answer.yes') }}{% else %}{{ t('model.answer.no') }}{% endif %}</td>
                </tr>
            {% endif %}
            <tr>
                <td><strong>{{ t('model.meta.readonly') }}</strong></td>
                <td>{% if metaData.readonly %}{{ t('model.answer.yes') }}{% else %}{{ t('model.answer.no') }}{% endif %}</td>
            </tr>
            <tr>
                <td><strong>{{ t('model.meta.connection') }}</strong></td>
                <td>{% if metaData.connection !== null %}{{ t('model.meta.namedConnection', ['connection': metaData.connection]) }}{% else %}{{ t('model.meta.managerConnection') }}{% endif %}</td>
            </tr>
        </tbody>
    </table>

    {% if metaData.key !== null && is_a(metaData.key, '\Tuxxedo\Model\MetaData\ModelCompositeKey') %}
        <h3>{{ t('model.heading.compositeKey') }}</h3>
        <table>
            <thead>
                <tr>
                    <th>{{ t('model.column.property') }}</th>
                    <th>{{ t('model.column.column') }}</th>
                </tr>
            </thead>
            <tbody>
                {% for property, column in metaData.key.columns %}
                    <tr>
                        <td>{{ property }}</td>
                        <td>{{ column }}</td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    {% endif %}

    {% if metaData.columns | count > 0 %}
        <h3>{{ t('model.heading.columns') }}</h3>
        <table>
            <thead>
                <tr>
                    <th>{{ t('model.column.property') }}</th>
                    <th>{{ t('model.column.column') }}</th>
                    <th>{{ t('model.column.nullable') }}</th>
                    <th>{{ t('model.column.unique') }}</th>
                    <th>{{ t('model.column.readonly') }}</th>
                </tr>
            </thead>
            <tbody>
                {% for column in metaData.columns %}
                    <tr>
                        <td>{{ column.property }}</td>
                        <td>{{ column.column }}</td>
                        <td>{% if column.nullable %}{{ t('model.answer.yes') }}{% else %}{{ t('model.answer.no') }}{% endif %}</td>
                        <td>{% if column.unique %}{{ t('model.answer.yes') }}{% else %}{{ t('model.answer.no') }}{% endif %}</td>
                        <td>{% if column.readonly %}{{ t('model.answer.yes') }}{% else %}{{ t('model.answer.no') }}{% endif %}</td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    {% endif %}

    {% if metaData.identifiers | count > 0 %}
        <h3>{{ t('model.heading.identifiers') }}</h3>
        <table>
            <thead>
                <tr>
                    <th>{{ t('model.column.column') }}</th>
                </tr>
            </thead>
            <tbody>
                {% for identifier in metaData.identifiers %}
                    <tr>
                        <td>{{ identifier.column }}</td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    {% endif %}

    {% if metaData.relations | count > 0 %}
        <h3>{{ t('model.heading.relations') }}</h3>
        <table>
            <thead>
                <tr>
                    <th>{{ t('model.column.property') }}</th>
                    <th>{{ t('model.column.relatedClass') }}</th>
                    <th>{{ t('model.column.nullable') }}</th>
                </tr>
            </thead>
            <tbody>
                {% for relation in metaData.relations %}
                    <tr>
                        <td>{{ relation.property }}</td>
                        <td>{{ relation.relatedClass }}</td>
                        <td>{% if relation.nullable %}{{ t('model.answer.yes') }}{% else %}{{ t('model.answer.no') }}{% endif %}</td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    {% endif %}

    {% if metaData.morphToRelations | count > 0 %}
        <h3>{{ t('model.heading.morphToRelations') }}</h3>
        <table>
            <thead>
                <tr>
                    <th>{{ t('model.column.property') }}</th>
                    <th>{{ t('model.column.typeColumn') }}</th>
                    <th>{{ t('model.column.idColumn') }}</th>
                    <th>{{ t('model.column.nullable') }}</th>
                </tr>
            </thead>
            <tbody>
                {% for morph in metaData.morphToRelations %}
                    <tr>
                        <td>{{ morph.property }}</td>
                        <td>{{ morph.typeColumn }}</td>
                        <td>{{ morph.idColumn }}</td>
                        <td>{% if morph.nullable %}{{ t('model.answer.yes') }}{% else %}{{ t('model.answer.no') }}{% endif %}</td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    {% endif %}

    {% if metaData.aggregates | count > 0 %}
        <h3>{{ t('model.heading.aggregates') }}</h3>
        <table>
            <thead>
                <tr>
                    <th>{{ t('model.column.property') }}</th>
                    <th>{{ t('model.column.alias') }}</th>
                    <th>{{ t('model.column.relation') }}</th>
                    <th>{{ t('model.column.function') }}</th>
                    <th>{{ t('model.column.column') }}</th>
                    <th>{{ t('model.column.slotType') }}</th>
                </tr>
            </thead>
            <tbody>
                {% for aggregate in metaData.aggregates %}
                    <tr>
                        <td>{{ aggregate.property }}</td>
                        <td>{{ aggregate.alias }}</td>
                        <td>{{ aggregate.relation }}</td>
                        <td>{{ aggregate.function.value }}</td>
                        <td>{% if aggregate.column !== null %}{{ aggregate.column }}{% else %}&mdash;{% endif %}</td>
                        <td>{{ aggregate.slotType }}</td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    {% endif %}

    {% if metaData.behaviors | count > 0 %}
        <h3>{{ t('model.heading.behaviors') }}</h3>
        <table>
            <thead>
                <tr>
                    <th>{{ t('model.column.property') }}</th>
                    <th>{{ t('model.column.behaviorClass') }}</th>
                </tr>
            </thead>
            <tbody>
                {% for property, behaviorClass in metaData.behaviors %}
                    <tr>
                        <td>{{ property }}</td>
                        <td>{{ behaviorClass }}</td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    {% endif %}

    {% if metaData.uniques | count > 0 %}
        <h3>{{ t('model.heading.uniques') }}</h3>
        <table>
            <thead>
                <tr>
                    <th>{{ t('model.column.columns') }}</th>
                </tr>
            </thead>
            <tbody>
                {% for unique in metaData.uniques %}
                    <tr>
                        <td>{{ join(unique, ', ') }}</td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    {% endif %}

    {% if metaData.indexes | count > 0 %}
        <h3>{{ t('model.heading.indexes') }}</h3>
        <table>
            <thead>
                <tr>
                    <th>{{ t('model.column.columns') }}</th>
                </tr>
            </thead>
            <tbody>
                {% for index in metaData.indexes %}
                    <tr>
                        <td>{{ join(index, ', ') }}</td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    {% endif %}
{% endblock %}
