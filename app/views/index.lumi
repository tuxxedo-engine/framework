{% layout 'layout/base' %}

{% block main %}
    <main>
        <header>
            <h1>Tuxxedo Engine<sup>{{ engineVersion }}</sup></h1>
            <div class="meta">
                <div>{{ appName }} {{ appVersion }}</div>
                <div>{{ date('Y-m-d H:i:s T') }} (UTC{{ date('P') }})</div>
            </div>
        </header>
        <section class="status">
            <p class="environment">{{ appEnvironment }}</p>
            <p class="location">serving <span class="url">{{ appUrl }}</span></p>
            <p class="message">Application is running. Add controllers under <code>app/Controllers/</code> and register
                routes with <code>#[Route]</code>. Configuration lives in <code>app/config/</code>, views in <code>app/views/</code>.
            </p>
        </section>
        <section class="environment">
            <p class="caption">Environment</p>
            <dl>
                <div class="row">
                    <dt>Engine</dt>
                    <dd>{{ engineVersionFull }}</dd>
                </div>
                <div class="row">
                    <dt>PHP</dt>
                    <dd>{{ phpVersion }} ({{ phpSapi }})</dd>
                </div>
                <div class="row">
                    <dt>Application</dt>
                    <dd>{{ appName }} {{ appVersion }}</dd>
                </div>
                <div class="row">
                    <dt>URL</dt>
                    <dd>{{ appUrl }}</dd>
                </div>
                <div class="row">
                    <dt>Timezone</dt>
                    <dd>{{ timezone }}</dd>
                </div>
            </dl>
        </section>
    </main>
{% endblock %}